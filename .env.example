# ── 公开站点 URL ─────────────────────────────────────────────
# 生产环境必须显式配置；未配置时会用 Vercel 域名兜底，本地才回落到 localhost。
NEXT_PUBLIC_SITE_URL=https://galgame-guide.vercel.app
NEXT_PUBLIC_MAIN_SITE_URL=https://www.krzacg.com

# ── 数据源（只读）────────────────────────────────────────────
# 主站已删除 /api/posts/hot-feed（KrzACG 1fce7991，2026-10-14）。
# 过渡期使用 /api/posts/latest；公开契约 /api/public/v1 目前没有 posts 端点。
CONTENT_SOURCE_API_URL=https://service.krzacg.com/api/posts/latest
CONTENT_SYNC_PAGE_SIZE=50
# 只收游戏分类。`hentai` 是万能标签（66% 的帖子都带），写成 hentai,game 等于
# 把同人志/ASMR/MMD/写真/Cosplay 全拉进来。`game` 才是真游戏分类。
CONTENT_SYNC_CATEGORY_SLUGS=game,single-player-games
CONTENT_SYNC_EXCLUDE_KEYWORDS=mmd,vam,virt-a-mate
CONTENT_SYNC_STOP_THRESHOLD=100
CONTENT_SYNC_IMAGE_CDN=https://upload.krzacg.com
# 手动 CLI 的默认页数由 --full / --max-pages 决定，这里只控制 cron 的增量页数。
CRON_SYNC_MAX_PAGES=2

# ── Turso / libSQL ──────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# ── Cron 鉴权 ───────────────────────────────────────────────
# 配置后 /api/cron/sync-content 只接受 Authorization: Bearer <CRON_SECRET>。
# 留空时退回 Vercel Cron 的 User-Agent 识别（UA 可伪造，生产必须配置）。
CRON_SECRET=

# ── 可选 ────────────────────────────────────────────────────
# IndexNow 归属校验 key，覆盖 lib/indexnow.mjs 里的默认值。留空即用默认值。
# 轮换时两处同步改：这里的环境变量 + lib/indexnow.mjs 的 INDEXNOW_KEY。
INDEXNOW_KEY=
